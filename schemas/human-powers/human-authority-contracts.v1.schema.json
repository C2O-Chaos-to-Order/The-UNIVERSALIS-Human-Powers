            },
            "deletion_request_supported": {
              "type": "boolean"
            },
            "retention_policy_ref": {
              "type": "string"
            }
          },
          "required": [
            "storage_control",
            "portability",
            "deletion_request_supported"
          ],
          "additionalProperties": false
        },
        "consent_graph_ref": {
          "type": "string"
        },
        "privacy_preferences_ref": {
          "type": "string"
        },
        "issued_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "fixture_only": {
          "type": "boolean"
        },
        "rights_request_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dsar_profile_ref": {
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "profile_id",
        "subject_ref",
        "credential_format",
        "data_control",
        "issued_at",
